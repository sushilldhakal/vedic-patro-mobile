{
  "expo": {
    "name": "Vedic Patro",
    "slug": "vedic-patro-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "vedicpatro",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#073f43"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vedicpatro.mobile",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "vedicpatro"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "fb1044570391345268"
            ]
          }
        ],
        "LSApplicationQueriesSchemes": [
          "fbapi",
          "fb-messenger-share-api",
          "fbauth2",
          "fbshareextension"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#073f43"
      },
      "package": "com.vedicpatro.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "vedicpatro"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "fb1044570391345268"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.ico"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#073f43"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vedic Patro uses your location to show accurate panchanga for your area."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://www.vedicpatro.com/api",
      "apiVersion": "v1",
      "googleWebClientId": "568648791161-elpu27mjfjhcb3p9rm2vim62kgrqinao.apps.googleusercontent.com",
      "googleIosClientId": "",
      "googleAndroidClientId": "",
      "facebookAppId": "1044570391345268",
      "router": {},
      "eas": {
        "projectId": "875bd091-9544-4881-9b60-7a268c11a7ac"
      },
      "googleIosReversedClientId": ""
    }
  }
}
